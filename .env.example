# Copy to .env and fill in. Never commit .env.
# In production, the server refuses to start if a required value is missing or weak.

# development | production | test
NODE_ENV=development

# Address and port the Node process listens on. Keep 127.0.0.1 behind Caddy/Nginx.
HOST=127.0.0.1
PORT=3000

# Public address of the site, no trailing slash. Used for canonical URLs, sitemap
# and social previews. Must be https:// in production.
SITE_URL=http://localhost:3000

# Set when running behind a reverse proxy so rate limits see the real visitor IP.
#   false     – no proxy (local development)
#   loopback  – Caddy/Nginx on the same server (typical VPS setup)
#   1         – exactly one proxy hop (most PaaS platforms)
TRUST_PROXY=false

# SQLite database file (media metadata + admin sessions). Relative paths are from
# the project folder. Back this file up (see scripts/backup.sh).
DATABASE_PATH=var/smart-getfit.db

# Folder for processed uploaded images. Back this up too.
UPLOAD_DIR=uploads

# URL path of the admin panel. A less guessable path (e.g. /manage-7f3a) cuts down
# on bots probing it; it is not a substitute for the password.
ADMIN_PATH=/admin

# The single admin account. Generate the hash with:  npm run hash-password
# (Required in production. Leave both empty in development to disable admin.)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Random secret, at least 32 characters, used for CSRF tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (Required in production.)
SESSION_SECRET=

# debug | info | warn | error | silent  (default: debug in development, info in production)
LOG_LEVEL=
