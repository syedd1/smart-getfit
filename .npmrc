# Don't run dependencies' install scripts.
# - The native packages (better-sqlite3, sharp, argon2) ship ready-made binaries for
#   Windows/Linux/macOS; without this, npm tries to compile better-sqlite3 from source
#   when installing from package-lock.json, which fails on machines without C++ tools.
# - A compromised dependency can't run code during `npm install`.
# Our own `npm run …` / `npm start` / `npm test` commands still run normally.
ignore-scripts=true
